# ---------------------------------------------------------------------------
# Leva — environment configuration
# Copy to `.env.local` and fill in. NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# Public origin of the deployment. Used to build QR/NFC payload URLs and to
# validate the Origin header on state-changing requests (CSRF defence).
# Must include the scheme and no trailing slash.
APP_ORIGIN="http://localhost:3000"

# 32+ byte random secret used to sign session cookies and derive the CSRF key.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Independent 32+ byte secret used as the peppering key for IP hashing.
# Rotating this makes all previously stored IP hashes unlinkable.
IP_HASH_SECRET=""

# Absolute or relative path to the SQLite database file.
DATABASE_PATH="./data/leva.db"

# Bootstrap administrator. Only read by `npm run db:seed` — the values are
# hashed into the database and never stored in plaintext.
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD=""

# Set to "1" behind a trusted reverse proxy so X-Forwarded-For is honoured.
# Leave unset when the app is directly exposed, otherwise clients can spoof
# their own IP and bypass rate limiting.
TRUST_PROXY_HEADERS="0"
